{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "${TEAMS_APP_ID}",
  "developer": {
    "name": "Mantoman",
    "websiteUrl": "https://${TEAMS_APP_HOST}",
    "privacyUrl": "https://${TEAMS_APP_HOST}/privacy",
    "termsOfUseUrl": "https://${TEAMS_APP_HOST}/terms"
  },
  "name": { "short": "Mantoman", "full": "Mantoman Project Assistant" },
  "description": { "short": "Project requirement assistant", "full": "Responds to mentions about approved project requirements and assignments." },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#2563EB",
  "bots": [{ "botId": "${TEAMS_BOT_ID}", "scopes": ["team"], "supportsFiles": false, "isNotificationOnly": false }],
  "permissions": ["identity"],
  "validDomains": ["${TEAMS_APP_HOST}"]
}
